{
  "name": "@mobiletaplay/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MobileTaPlay Capacitor shell (Android → iOS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@mobiletaplay/input-bridge": "workspace:*",
    "@mobiletaplay/input-mapping": "workspace:*",
    "@mobiletaplay/shell-common": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
