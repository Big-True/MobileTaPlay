{
  "name": "mobiletaplay",
  "private": true,
  "version": "0.1.0",
  "description": "MobileTaPlay — third-party cross-platform client for h5mota (HTML5 Magic Tower)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "mobile:dev": "pnpm --filter @mobiletaplay/mobile dev",
    "mobile:sync": "pnpm --filter @mobiletaplay/mobile sync"
  }
}
